{
  "name": "capsaai-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --port 8081",
    "ios": "expo start --ios --port 8081",
    "android": "expo start --android --port 8081",
    "web": "expo start --web --port 8081",
    "typecheck": "tsc --noEmit",
    "server:dev": "tsx server/server.ts",
    "server:migrate": "tsx server/migrate.ts",
    "server:seed:dev": "tsx server/seed-dev.ts",
    "server:typecheck": "tsc --noEmit -p tsconfig.server.json",
    "bot:dev": "tsx bot/server.ts",
    "bot:typecheck": "tsc --noEmit -p tsconfig.bot.json",
    "bot:vincular": "tsx bot/vincular-usuario.ts",
    "bot:audio": "tsx bot/probar-audio.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.3.0",
    "dotenv": "^17.4.2",
    "expo": "~54.0.0",
    "expo-crypto": "~15.0.9",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "1.26.0",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "~19.1.10",
    "tsx": "^4.23.12",
    "typescript": "~5.9.2"
  }
}
